# Entity: reference

main: kit: entity: reference: {

  alias: field: {}

  fields: [
    {
      name: "countryCode"
      req: false
      short: "ISO country code"
      type: "`$STRING`"
    }
    {
      name: "countryName"
      req: false
      short: "Country name"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "flagUrl"
      req: false
      short: "URL to flag image"
      type: "`$STRING`"
    }
  ]

  name: "reference"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/data/flags"
          segments: [
            {
              lit: "data"
            }
            {
              lit: "flags"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.flags`"
          }
        }
      ]
    }
  }



}
